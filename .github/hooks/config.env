# Hook Configuration
# 
# Configuration for GitHub Copilot Coding Agent hooks
# Override defaults with environment variables

# Telemetry directory (relative to repo root)
TELEMETRY_DIR=.github/telemetry

# Memory directory (relative to repo root)
MEMORY_DIR=.github/memory

# Enable verbose logging for hooks
HOOK_VERBOSE=false

# File validation settings
VALIDATE_ON_EDIT=true
VALIDATE_LINT=true
VALIDATE_TYPES=true

# Knowledge graph settings
UPDATE_KNOWLEDGE_ON_SESSION_END=true
AUTO_DETECT_ARCHITECTURE_CHANGES=true
AUTO_DETECT_DEPENDENCY_CHANGES=true

# Session tracking
TRACK_COMMANDS=true
TRACK_FILE_CHANGES=true
TRACK_ERRORS=true

# Performance settings
MAX_FILES_TO_VALIDATE=10
MAX_COMMAND_LENGTH=200
MAX_ERROR_MESSAGE_LENGTH=500
