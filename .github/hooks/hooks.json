{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": ".github/hooks/session-start.js",
        "cwd": ".",
        "timeoutSec": 15,
        "env": {
          "HOOK_VERBOSE": "${HOOK_VERBOSE:-false}"
        }
      },
      {
        "type": "command",
        "bash": ".github/hooks/ziit-heartbeat.js",
        "cwd": ".",
        "timeoutSec": 10,
        "env": {
          "ZIIT_API_KEY": "${ZIIT_API_KEY}",
          "ZIIT_BASE_URL": "${ZIIT_BASE_URL:-https://ziit.app}",
          "ZIIT_EDITOR": "${ZIIT_EDITOR:-github-copilot-agent}",
          "ZIIT_VERBOSE": "${ZIIT_VERBOSE:-false}"
        }
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": ".github/hooks/session-end.js",
        "cwd": ".",
        "timeoutSec": 30,
        "env": {
          "HOOK_VERBOSE": "${HOOK_VERBOSE:-false}"
        }
      },
      {
        "type": "command",
        "bash": ".github/hooks/ziit-heartbeat.js",
        "cwd": ".",
        "timeoutSec": 10,
        "env": {
          "ZIIT_API_KEY": "${ZIIT_API_KEY}",
          "ZIIT_BASE_URL": "${ZIIT_BASE_URL:-https://ziit.app}",
          "ZIIT_EDITOR": "${ZIIT_EDITOR:-github-copilot-agent}",
          "ZIIT_VERBOSE": "${ZIIT_VERBOSE:-false}"
        }
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": ".github/hooks/ziit-heartbeat.js",
        "cwd": ".",
        "timeoutSec": 5,
        "env": {
          "ZIIT_API_KEY": "${ZIIT_API_KEY}",
          "ZIIT_BASE_URL": "${ZIIT_BASE_URL:-https://ziit.app}",
          "ZIIT_EDITOR": "${ZIIT_EDITOR:-github-copilot-agent}",
          "ZIIT_VERBOSE": "${ZIIT_VERBOSE:-false}"
        }
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": ".github/hooks/pre-tool-use.js",
        "cwd": ".",
        "timeoutSec": 5,
        "env": {
          "HOOK_VERBOSE": "${HOOK_VERBOSE:-false}"
        }
      },
      {
        "type": "command",
        "bash": ".github/hooks/ziit-heartbeat.js",
        "cwd": ".",
        "timeoutSec": 5,
        "env": {
          "ZIIT_API_KEY": "${ZIIT_API_KEY}",
          "ZIIT_BASE_URL": "${ZIIT_BASE_URL:-https://ziit.app}",
          "ZIIT_EDITOR": "${ZIIT_EDITOR:-github-copilot-agent}",
          "ZIIT_VERBOSE": "${ZIIT_VERBOSE:-false}"
        }
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": ".github/hooks/post-tool-use.js",
        "cwd": ".",
        "timeoutSec": 15,
        "env": {
          "HOOK_VERBOSE": "${HOOK_VERBOSE:-false}"
        }
      },
      {
        "type": "command",
        "bash": ".github/hooks/ziit-heartbeat.js",
        "cwd": ".",
        "timeoutSec": 5,
        "env": {
          "ZIIT_API_KEY": "${ZIIT_API_KEY}",
          "ZIIT_BASE_URL": "${ZIIT_BASE_URL:-https://ziit.app}",
          "ZIIT_EDITOR": "${ZIIT_EDITOR:-github-copilot-agent}",
          "ZIIT_VERBOSE": "${ZIIT_VERBOSE:-false}"
        }
      }
    ],
    "errorOccurred": [
      {
        "type": "command",
        "bash": ".github/hooks/error-occurred.js",
        "cwd": ".",
        "timeoutSec": 5,
        "env": {
          "HOOK_VERBOSE": "${HOOK_VERBOSE:-false}"
        }
      },
      {
        "type": "command",
        "bash": ".github/hooks/ziit-heartbeat.js",
        "cwd": ".",
        "timeoutSec": 5,
        "env": {
          "ZIIT_API_KEY": "${ZIIT_API_KEY}",
          "ZIIT_BASE_URL": "${ZIIT_BASE_URL:-https://ziit.app}",
          "ZIIT_EDITOR": "${ZIIT_EDITOR:-github-copilot-agent}",
          "ZIIT_VERBOSE": "${ZIIT_VERBOSE:-false}"
        }
      }
    ]
  }
}
