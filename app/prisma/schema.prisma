generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Item {
  id               String         @id @default(uuid())
  title            String?
  category         Category?
  state            ItemState      @default(available)
  accessoryType    AccessoryType? @map("accessory_type")
  jewelryType      JewelryType?   @map("jewelry_type")
  shoeType         ShoeType?      @map("shoe_type")
  bottomsType      BottomsType?   @map("bottoms_type")
  brand            String?
  sizeText         String?        @map("size_text")
  materials        String?
  isLicensedMerch  Boolean?       @map("is_licensed_merch")
  franchise        String?
  franchiseType    FranchiseType? @map("franchise_type")
  isGenerated      Boolean        @default(false) @map("is_generated")
  sourceItemId     String?        @map("source_item_id")
  generationType   String?        @map("generation_type")
  colorPalette     Json?          @map("color_palette")
  attributes       Json?
  cleanStatus      CleanStatus    @default(clean) @map("clean_status")
  wearsBeforeWash  Int            @default(1) @map("wears_before_wash")
  currentWears     Int            @default(0) @map("current_wears")
  lastWornDate     DateTime?      @map("last_worn_date")
  lastWashedDate   DateTime?      @map("last_washed_date")
  storageType      StorageType?   @map("storage_type")
  locationInCloset String?        @map("location_in_closet")
  sortOrder        Int?           @map("sort_order")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  hasRemovablePads Boolean?       @map("has_removable_pads")
  hasTucking       Boolean?       @map("has_tucking")
  aiJobs           AIJob[]
  images           ImageAsset[]
  tags             ItemTag[]
  nfcEvents        NFCEvent[]
  nfcTag           NFCTag?
  outfitItems      OutfitItem[]

  @@map("items")
}

model ImageAsset {
  id        String    @id @default(uuid())
  itemId    String    @map("item_id")
  kind      ImageKind
  filePath  String    @map("file_path")
  width     Int?
  height    Int?
  mimeType  String?   @map("mime_type")
  createdAt DateTime  @default(now()) @map("created_at")
  item      Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([kind])
  @@map("image_assets")
}

model Tag {
  id        String    @id @default(uuid())
  name      String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  itemTags  ItemTag[]

  @@map("tags")
}

model ItemTag {
  itemId String @map("item_id")
  tagId  String @map("tag_id")
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([itemId, tagId])
  @@index([itemId])
  @@index([tagId])
  @@map("item_tags")
}

model Outfit {
  id              String        @id @default(uuid())
  title           String?
  notes           String?
  rating          OutfitRating  @default(neutral)
  weather         String?
  vibe            String?
  occasion        String?
  timeAvailable   String?       @map("time_available")
  explanation     String?
  swapSuggestions String?       @map("swap_suggestions")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  aiJobs          AIJob[]
  images          OutfitImage[]
  items           OutfitItem[]

  @@map("outfits")
}

model OutfitItem {
  outfitId String     @map("outfit_id")
  itemId   String     @map("item_id")
  role     OutfitRole
  item     Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  outfit   Outfit     @relation(fields: [outfitId], references: [id], onDelete: Cascade)

  @@id([outfitId, itemId])
  @@index([outfitId])
  @@index([itemId])
  @@map("outfit_items")
}

model OutfitImage {
  id        String    @id @default(uuid())
  outfitId  String    @map("outfit_id")
  kind      ImageKind
  filePath  String    @map("file_path")
  width     Int?
  height    Int?
  mimeType  String?   @map("mime_type")
  createdAt DateTime  @default(now()) @map("created_at")
  outfit    Outfit    @relation(fields: [outfitId], references: [id], onDelete: Cascade)

  @@index([outfitId])
  @@index([kind])
  @@map("outfit_images")
}

model AIJob {
  id             String      @id @default(uuid())
  type           AIJobType
  status         AIJobStatus @default(queued)
  itemId         String?     @map("item_id")
  outfitId       String?     @map("outfit_id")
  inputRefs      Json?       @map("input_refs")
  outputJson     Json?       @map("output_json")
  confidenceJson Json?       @map("confidence_json")
  modelName      String?     @map("model_name")
  rawResponse    String?     @map("raw_response")
  error          String?
  attempts       Int         @default(0)
  maxAttempts    Int         @default(3) @map("max_attempts")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  completedAt    DateTime?   @map("completed_at")
  item           Item?       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  outfit         Outfit?     @relation(fields: [outfitId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([outfitId])
  @@index([status])
  @@index([type])
  @@map("ai_jobs")
}

model NFCTag {
  id        String   @id @default(uuid())
  tagId     String   @unique @map("tag_id")
  label     String?
  itemId    String   @unique @map("item_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([tagId])
  @@map("nfc_tags")
}

model NFCEvent {
  id        String   @id @default(uuid())
  tagId     String   @map("tag_id")
  itemId    String   @map("item_id")
  action    String
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([tagId])
  @@index([createdAt])
  @@map("nfc_events")
}

enum Category {
  tops
  bottoms
  dresses
  outerwear
  shoes
  accessories
  underwear_bras
  jewelry
  swimwear
  activewear
  sleepwear
  loungewear
  suits_sets
}

enum AccessoryType {
  purse
  bag
  backpack
  belt
  hat
  scarf
  gloves
  sunglasses
  watch
  other
}

enum JewelryType {
  necklace
  earrings
  bracelet
  ring
  anklet
  brooch
  other
}

enum ShoeType {
  sneakers
  boots
  sandals
  heels
  flats
  loafers
  oxfords
  platforms
  other
}

enum BottomsType {
  jeans
  dress_pants
  casual_pants
  cargo_pants
  shorts
  skirt
  leggings
  joggers
  other
}

enum FranchiseType {
  band
  movie
  tv_show
  game
  anime
  comic
  sports
  brand
  other
}

enum ItemState {
  available
  laundry
  unavailable
  donate
}

enum CleanStatus {
  clean
  dirty
  needs_wash
}

enum StorageType {
  hanging
  folded
  drawer
  shelf
  box
  other
}

enum ImageKind {
  original_main
  original_back
  label_brand
  label_care
  detail
  ai_catalog
  thumbnail
  outfit_board
  outfit_person_wearing
}

enum OutfitRole {
  top
  bottom
  dress
  outerwear
  shoes
  accessory
  underwear_bras
  jewelry
  swimwear
  activewear
  sleepwear
  loungewear
  suit_set
}

enum OutfitRating {
  up
  down
  neutral
}

enum AIJobType {
  generate_catalog_image
  infer_item
  extract_label
  generate_outfit
  generate_outfit_visualization
}

enum AIJobStatus {
  queued
  running
  succeeded
  failed
  needs_review
}
